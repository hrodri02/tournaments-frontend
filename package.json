    "@testing-library/react-native": "^12.2.2",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "19.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.13",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
